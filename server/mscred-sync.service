[Unit]
Description=Cert Prep progress sync (ms.71177117.xyz)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/mscred-sync/sync_server.py --addr 127.0.0.1 --port 8793 --data /var/lib/mscred-sync
User=mscred
Group=mscred
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mscred-sync

[Install]
WantedBy=multi-user.target
